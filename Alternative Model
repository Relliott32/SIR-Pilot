import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import odeint
import pandas as pd

def func_o(omega, z1):
    return omega + z1;
def func_v(v, z2):
    return v + z2;

#returns the number of days for U <= 20% of U0
def U_threshold_time(params):
    omega, v, eta, z1, z2, a, N, C0 = params
    R0 = 0
    U0 = N - C0

    times = np.arange(0,1000,1) #time in days
    sol = odeint(derive, y0=[U0,R0,C0], t=times, args=(eta, v,omega, z1, z2, a))

    U=sol.T[0]
    R=sol.T[1]
    C=sol.T[2]

    for i in range(len(U)):
        if U[i].round() <= U0*0.2:
            return i

#returns the number of days for C >= 60% of N 
def C_threshold_time_60(params):
    omega, v, eta, z1, z2, a, N, C0 = params
    #initial conditions
    R0 = 0
    U0 = N - C0

    times = np.arange(0,1000,1) #time in days
    sol = odeint(derive, y0=[U0,R0,C0], t=times, args=(eta, v,omega, z1, z2, a))

    U=sol.T[0]
    R=sol.T[1]
    C=sol.T[2]

    for i in range(len(C)):
        if C[i].round() >= N*0.6:
            return i

# returns the number of days for C >= 80% of N
def C_threshold_time_80(params):
    omega, v, eta, z1, z2, a, N, C0 = params
    #initial conditions
    R0 = 0
    U0 = N - C0

    times = np.arange(0,1000,1) #time in days
    sol = odeint(derive, y0=[U0,R0,C0], t=times, args=(eta, v,omega, z1, z2, a))

    C=sol.T[2]

    for i in range(len(C)):
        if C[i].round() >= N*0.8:
            return i

def derive(I, t, eta,  v, omega, z1, z2, a):
    U = I[0]
    R = I[1]
    C = I[2]
    return [
        (-(func_o(omega, z1) + eta)*U), #U
        (eta*U - func_v(v, z2)*R + a*C), #R
        ((func_v(v, z2))*R + (func_o(omega, z1))*U - a*C), #C
    ]

