def func_o(omega, z1):
    return omega + z1;

def func_v(v, z2):
    return v + z2;

def derive(I, t, omega, v, eta, z1, z2, a):
    U = I[0]
    R = I[1]
    C = I[2]
    return [
        (-(func_o(omega, z1) + eta)*U), #U
        (eta*U - func_v(v, z2)*R + a*C), #R
        ((func_v(v, z2))*R + (func_o(omega, z1))*U - a*C), #C
    ]

def urc_model(params):
    omega, v, eta, z1, z2, a, C0, U0 = params
    R0 = 0
    N = U0 + R0 + C0  #people with SUDs who are unconnected
    #initial conditions

    times = np.arange(0,1200,1) #time in days
    sol = odeint(derive, y0=[U0,R0,C0], t=times, args=(omega, v, eta, z1, z2, a))

    U=sol.T[0]
    R=sol.T[1]
    C=sol.T[2]

    #print(type(U))
    #print(U)

    for i in range(len(C)):
        if C[i].round() >= N*0.8:
            #print(type(i))
            #print(i)
            return i
    else:
        print("C never reaches the threshold within the time frame.")
        return 5000


