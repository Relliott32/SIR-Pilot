import numpy as np
from numpy.random import gamma
from scipy.integrate import odeint
from SALib.sample import sobol
from SALib.analyze import sobol
import matplotlib.pyplot as plt
import SALib
import pandas as pd

def derive(I, t, beta, z, eta, mu, muD, v, gamma):
    U = I[0]
    R = I[1]
    C = I[2]
    return [
        (-beta*z*U), #U
        (beta*z*U) - (v*R), #R
        (v*R), #C
    ]
beta = .1039 #rate referal into R
z = 0.83 # rate 0f awareness
mu = 0 # natural death rate
muD = 0#death rate related to behavioral issues
eta = 0 #crisis rate
v = 0.084 #rate of connection
gamma = 0 #new cases per day
# total pop in country

def urc_model(params):
    beta, z, v = params
    N = 2975000 #people with SUDs who are unconnected
    #initial conditions
    C0 = 562000
    R0 = (N-C0)*beta
    U0 = N - C0-R0

    times = np.arange(0,180,1) #time in days
    sol = odeint(derive, y0=[U0,R0,C0], t=times, args=(beta, z, eta, mu,muD, v, gamma))

    U=sol.T[0]
    R=sol.T[1]
    C=sol.T[2]

    return U[-1]  # Return the final values of U, R, and C as the output of the model



#Define problem
problem = {
    'num_vars': 3,
    'names': ['beta', 'z', 'v'],
    'bounds': [[0.0669, 0.1645], [0.001, 1], [0.0579, 0.1212]]
}

#Sample input space
param_values = SALib.sample.sobol.sample(problem, 2048)

#Evaluate model
Y = np.array([urc_model(params) for params in param_values])

Si = sobol.analyze(problem, Y, calc_second_order=True, conf_level = 0.95, print_to_console=True)  # Analyze the first output (U)

# Prepare data for plotting
params = problem['names']
S1 = np.array(Si['S1'])
ST = np.array(Si['ST'])

# Plot bar chart of first-order and total-order indices
fig, ax = plt.subplots(figsize=(8,5))
x = np.arange(len(params))
width = 0.35

ax.bar(x - width/2, S1, width, label='First-order (S1)', color='steelblue')
ax.bar(x + width/2, ST, width, label='Total-order (ST)', color='coral')
ax.set_xlabel('Parameters')
ax.set_ylabel('Sensitivity Index')
ax.set_title('Sobol Sensitivity Indices')
ax.set_xticks(x)
ax.set_xticklabels(params, rotation=45)
ax.legend()
ax.grid(True, linestyle='--', alpha=0.6)
plt.tight_layout()
plt.show()
