def simulate(beta, z, v):
        def derive(I, t, beta, z, v):
            U = I[0]
            R = I[1]
            C = I[2]
            return [
                (-beta*U*z), #U
                (beta*U*z) - (v*R), #R
                (v*R), #C
            ]

    #parameter list


        N = 2975000 #people with SUDs who are unconnected
        #initial conditions
        C0 = 562000
        R0 = (N-C0)*beta
        U0 = N - C0-R0
        times = np.arange(0,1500,1) #time in days
        sol = odeint(derive, y0=[U0,R0,C0], t=times, args=(beta, z, v,))
        
        U=sol.T[0]
        R=sol.T[1]
        C=sol.T[2]

        
        for i in range(len(U)):
            #print(U[i].round())
            if U[i].round() == 0:
                days = times[i]
                return days

        return 0
            


